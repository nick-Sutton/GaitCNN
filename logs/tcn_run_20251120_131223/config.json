{
    "data_files": "data/Train_Combined/*.csv",
    "window_length": 200,
    "stride": 50,
    "batch_size": 32,
    "label_column": "gait_type",
    "test_size": 0.2,
    "random_state": 42,
    "num_channels": [
        64,
        128,
        256
    ],
    "kernel_size": 7,
    "dropout_rate": 0.2,
    "epochs": 100,
    "learning_rate": 0.001,
    "early_stopping_patience": 10,
    "class_names": [
        "jog",
        "quasi",
        "stair_acsent",
        "stair_decsent",
        "stand",
        "step_acsent",
        "step_decsent",
        "walk"
    ]
}